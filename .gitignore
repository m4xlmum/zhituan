# 依赖
node_modules/

# electron-vite 构建产物
out/
*.tsbuildinfo

# electron-builder 打包产物
# 注意：build/ 不在此列，它用于存放图标等打包资源
dist/
release/
# 打某版本时为了让 electron-builder 绕开既有 release/ 目录，会临时换一个全新输出
# 目录 release-<版本>/（沙箱只允许移动文件、不允许移动既有目录）。归位到 release/
# 之后这些目录就是历史残留，不该跟着仓库走。
release-*/

# 环境变量与本地配置
.env
.env.local
.env.*.local
.claude/settings.local.json

# 编辑器与 IDE
.vscode/
.idea/
*.swp
*.swo

# 操作系统
.DS_Store
Thumbs.db
desktop.ini

# 日志
*.log
logs/

# spike 的运行产物（脚本本身保留，便于在其它机器上复核）
spike/report.json
spike/*.png
spike/out/
# 探针的编译产物：.nsi / .py 是源码，留下；makensis 打出来的 .exe 是本机跑一次
# 就有的东西（几十 KB 一个），没有版本意义，也不该跟着仓库走。
spike/**/*.exe
# 探针自己搭出来的现场（preflight 的 fixture 目录）与写出来的读数文件：每次跑都会
# 重新生成，check_round.py 断言的就是「这一趟跑完长什么样」，留着只会让状态一直脏。
spike/nsis-abort-probe/pf-fixture/
spike/nsis-abort-probe/*.txt

# 评审截图：是过程证据，不是产物，体积也大
.impeccable/review/

# 增长与传播材料：里面是竞品分析与投放策略，属于内部文档，
# 不该跟着代码一起公开。需要公开的话把这两行删掉即可。
GROWTH-STRATEGY.md
marketing/

# 工作记忆：.workbuddy/ 底下是本机的工作日志与项目记忆——
# 它是过程，不是产物，而且里面有讨论的原话与取舍过程，不该跟着代码一起公开。
# 注意别删这个目录（它存着跨会话的项目记忆），只是不进仓库。
.workbuddy/
